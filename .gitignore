# ---- Environment / secrets ----
# Never commit real env files (DB passwords, JWT secrets, etc.)
.env
*.env
!.env.example
config/*.env
!config/*.env.example

# ---- Go ----
# Binaries
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
# Test binary / coverage
*.test
*.out
coverage.*
# Go workspace file
go.work
go.work.sum
# Vendor (we use modules; uncomment if vendoring)
# vendor/

# ---- Flutter / Dart ----
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.iml
.pub-cache/
.pub/

# ---- Next.js / Node ----
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.turbo/

# ---- Editors / OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- Logs & temp ----
*.log
tmp/
temp/
